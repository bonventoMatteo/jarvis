# =========================================================================
# JARVIS — configuração. Copie para .env e ajuste.
# Todas as chaves são opcionais, exceto ANTHROPIC_API_KEY para tarefas
# complexas (comandos rápidos funcionam sem ela).
# =========================================================================

# ----------------------------- Identidade --------------------------------
ASSISTANT_NAME=Jarvis
# Como o Jarvis chama você: senhor, senhora, chefe, seu nome...
USER_TITLE=senhor
LANGUAGE=pt

# ------------------------------ Anthropic --------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Haiku classifica comandos que o regex não pegou; Sonnet é o agente com ferramentas.
MODEL_FAST=claude-haiku-4-5
MODEL_AGENT=claude-sonnet-4-5
MODEL_VISION=claude-sonnet-4-5
MAX_TOKENS_FAST=512
MAX_TOKENS_AGENT=4096
AGENT_MAX_TURNS=12

# -------------------------------- Áudio ----------------------------------
# Índices de `python main.py --list-devices`. Vazio = dispositivo padrão.
INPUT_DEVICE=
OUTPUT_DEVICE=
SAMPLE_RATE=16000
BLOCK_MS=40

# ------------------------- Detector de palmas ----------------------------
CLAP_ENABLED=true
# Pico precisa ser N vezes o ruído calibrado. Suba se disparar sozinho; desça se não ouvir.
CLAP_THRESHOLD_MULT=8.0
# Piso absoluto do pico (0-1), para salas muito silenciosas.
CLAP_MIN_PEAK=0.045
# Fração mínima da energia entre 2 e 4 kHz (palma é aguda, voz é grave).
CLAP_BAND_RATIO=0.30
CLAP_BAND_LOW_HZ=2000
CLAP_BAND_HIGH_HZ=4000
# Ataque máximo (ms) do início ao pico.
CLAP_ATTACK_MS=15
# Intervalo entre palmas: mínimo, máximo e debounce (ms).
CLAP_MIN_GAP_MS=150
CLAP_MAX_GAP_MS=1200
CLAP_DEBOUNCE_MS=300
CLAP_REQUIRED=2
CALIBRATION_SECONDS=5

# ------------------------------ Wake word --------------------------------
WAKE_ENABLED=true
# Pré-treinado "hey jarvis", ou o seu modelo: coloque jarvis.onnx em models/openwakeword/ e use WAKE_MODEL=jarvis.onnx
WAKE_MODEL=hey_jarvis_v0.1
WAKE_THRESHOLD=0.55
WAKE_COOLDOWN_MS=2000

# -------------------------------- Hotkey ---------------------------------
HOTKEY_ENABLED=true
HOTKEY=ctrl+alt+j

# --------------------------------- VAD -----------------------------------
VAD_THRESHOLD=0.5
# Silêncio (ms) que encerra a sua fala.
VAD_SILENCE_MS=800
VAD_MAX_RECORD_S=20
VAD_MIN_SPEECH_MS=250
VAD_PRESPEECH_MS=300

# --------------------------------- STT -----------------------------------
# distil-large-v3 é SOMENTE INGLÊS. Para pt-BR: large-v3-turbo (recomendado), large-v3, medium, small.
WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
WHISPER_DEVICE=auto
# auto (float16 na GPU, int8 na CPU) | float16 | int8_float16 | int8
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=1

# --------------------------------- TTS -----------------------------------
PIPER_VOICE=pt_BR-faber-medium
# < 1 fala mais rápido.
PIPER_LENGTH_SCALE=0.95
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8
# Cadeia pedalboard "IA de cinema".
TTS_EFFECTS=true
TTS_HIGHPASS_HZ=100
TTS_REVERB_WET=0.06
TTS_REVERB_ROOM=0.12
# Se distorcer, baixe para 0.
TTS_GAIN_DB=2.0
TTS_VOLUME=1.0

# -------------------------------- Sons -----------------------------------
SFX_VOLUME=0.55
AMBIENT_VOLUME=0.18
PLAY_BOOT_SOUND=true

# ------------------------------ Executor ---------------------------------
ALLOW_SHELL=true
# true = desliga/reinicia/apaga SEM pedir confirmação. Não recomendado.
ALLOW_DESTRUCTIVE=false
SHELL_TIMEOUT_S=60
CONFIRM_TIMEOUT_S=8

# ------------------------------ Navegador --------------------------------
BROWSER_HEADLESS=false
# chromium (baixado pelo playwright) | chrome | msedge
BROWSER_CHANNEL=chromium
BROWSER_TIMEOUT_MS=25000

# ------------------------------- Memória ---------------------------------
HISTORY_CONTEXT_TURNS=6

# ---------------------------------- UI -----------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_FPS=12
LOG_LEVEL=INFO
LOG_JSON_FILE=true
